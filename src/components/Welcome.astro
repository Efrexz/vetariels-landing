---
import {
  HeartHandshake,
  ShieldCheck,
  UsersRound,
  PawPrint,
  Quote,
} from "@lucide/astro";
---

<section
  id="welcome"
  class="relative overflow-hidden bg-brand-tint py-14 lg:py-24 opacity-0 translate-y-8 transition-all duration-700 ease-out"
  aria-labelledby="welcome-heading"
>
  <!-- Fondo decorativo: blobs azules suaves + huellitas (guía de la referencia) -->
  <div
    class="pointer-events-none absolute -left-28 -top-24 h-96 w-96 rounded-full bg-brand-sky/30 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-32 left-10 h-72 w-72 rounded-full bg-brand-blue/15 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-brand-sky/25 blur-2xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -bottom-16 -right-16 h-64 w-64 rounded-full bg-brand-orange/10 blur-2xl"
    aria-hidden="true"
  >
  </div>

  <!-- Huellitas decorativas -->
  <PawPrint
    aria-hidden="true"
    class="pointer-events-none absolute left-[6%] top-[14%] h-16 w-16 rotate-[-18deg] text-brand-sky/40"
    stroke-width="1.5"
  />
  <PawPrint
    aria-hidden="true"
    class="pointer-events-none absolute left-[3%] bottom-[18%] h-9 w-9 rotate-[15deg] text-brand-sky/30"
    stroke-width="1.5"
  />
  <PawPrint
    aria-hidden="true"
    class="pointer-events-none absolute right-[4%] top-[10%] h-12 w-12 rotate-[20deg] text-brand-sky/35"
    stroke-width="1.5"
  />
  <PawPrint
    aria-hidden="true"
    class="pointer-events-none absolute right-[8%] bottom-[10%] h-8 w-8 rotate-[-12deg] text-brand-sky/25"
    stroke-width="1.5"
  />

  <!-- Curva naranja decorativa (esquina inferior derecha, como la referencia) -->
  <svg
    viewBox="0 0 320 160"
    fill="none"
    class="pointer-events-none absolute -bottom-2 right-0 hidden h-40 w-80 lg:block"
    aria-hidden="true"
  >
    <path
      d="M-10 160 C 90 150, 200 110, 240 60 S 310 -5, 330 -5"
      stroke="#F5821F"
      stroke-width="4"
      stroke-linecap="round"></path>
  </svg>

  <div class="relative mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <!-- Columna visual: card con la insignia de vocación -->
      <div class="welcome-fade relative flex justify-center opacity-0 translate-y-4 transition-all duration-700 ease-out">
        <div
          class="pointer-events-none absolute -left-6 -top-6 h-full w-full -rotate-3 rounded-[2.5rem] bg-white/70"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative -rotate-2 rounded-[2.5rem] border border-brand-mist bg-white px-10 py-12 shadow-hero transition-transform duration-500 hover:rotate-0 sm:px-14"
        >
          <img
            src="/vocacion.webp"
            alt="Insignia naranja con corazón y huella: desde 2003, una vocación que continúa"
            width="1024"
            height="1024"
            loading="lazy"
            class="mx-auto w-full max-w-[300px] sm:max-w-[360px] lg:max-w-[400px]"
          />
        </div>
      </div>

      <!-- Columna de contenido -->
      <article class="welcome-fade relative px-2 sm:px-6 lg:px-0 lg:py-12 opacity-0 translate-y-4 transition-all duration-700 ease-out">
        <header>
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-orange">
            <PawPrint aria-hidden="true" class="h-4 w-4" stroke-width="2" />
            Nuestra forma de cuidar
          </p>
          <h2
            id="welcome-heading"
            class="mt-4 max-w-xl text-3xl font-bold leading-tight tracking-[-0.03em] text-brand-navy sm:text-4xl lg:text-[2.75rem]"
          >
            Profesionalismo y cuidado
            <span class="block text-brand-orange">en cada etapa</span>
          </h2>
          <div class="mt-4 flex items-center gap-1.5" aria-hidden="true">
            <span class="h-1 w-10 rounded-full bg-brand-orange"></span>
            <span class="h-1 w-1.5 rounded-full bg-brand-orange/50"></span>
          </div>
        </header>

        <p class="mt-6 max-w-2xl text-base leading-8 text-brand-ink/75 sm:text-lg">
          Contamos con un equipo altamente calificado y tecnología de vanguardia
          para ofrecer atención integral, desde consultas y cirugías hasta
          cuidados intensivos y servicios de Spa.
        </p>

        <figure
          class="mt-8 flex gap-4 rounded-3xl bg-white/80 p-6 shadow-card sm:gap-5"
        >
          <Quote
            aria-hidden="true"
            class="h-9 w-9 shrink-0 rotate-180 text-brand-blue"
            stroke-width="1.8"
          />
          <blockquote class="text-sm leading-7 text-brand-ink/80 sm:text-base sm:leading-8">
            “Desde la fundación de la clínica en 2003, el sueño ha sido crear un
            lugar donde la excelencia médica y el amor por los animales se unan.”
          </blockquote>
        </figure>

        <div class="mt-8 flex flex-wrap items-center gap-2.5" role="list" aria-label="Nuestros valores">
          <span
            class="flex items-center gap-1.5 rounded-full bg-brand-orange/10 px-4 py-2 text-xs font-semibold text-brand-navy sm:text-sm"
            role="listitem"
          >
            <HeartHandshake aria-hidden="true" class="h-4 w-4 text-brand-orange" stroke-width="1.8" />
            Atención personalizada
          </span>
          <span
            class="flex items-center gap-1.5 rounded-full bg-brand-blue/10 px-4 py-2 text-xs font-semibold text-brand-navy sm:text-sm"
            role="listitem"
          >
            <UsersRound aria-hidden="true" class="h-4 w-4 text-brand-blue" stroke-width="1.8" />
            Equipo especializado
          </span>
          <span
            class="flex items-center gap-1.5 rounded-full bg-brand-green/10 px-4 py-2 text-xs font-semibold text-brand-navy sm:text-sm"
            role="listitem"
          >
            <ShieldCheck aria-hidden="true" class="h-4 w-4 text-brand-green" stroke-width="1.8" />
            Seguridad y confianza
          </span>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  const initializeWelcome = () => {
    const welcomeSection = document.getElementById("welcome");
    if (!welcomeSection || welcomeSection.dataset.initialized === "true") return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-8");

            const fades = entry.target.querySelectorAll(".welcome-fade");
            fades.forEach((fade, index) => {
              window.setTimeout(() => {
                fade.classList.remove("opacity-0", "translate-y-4");
              }, 150 * index);
            });

            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(welcomeSection);
    welcomeSection.dataset.initialized = "true";
  };

  document.addEventListener("DOMContentLoaded", initializeWelcome, { once: true });

  initializeWelcome();
</script>
