---
import {
  HeartHandshake,
  ShieldCheck,
  UsersRound,
  PawPrint,
  Heart,
  Quote,
} from "@lucide/astro";
---

<section
  id="welcome"
  class="bg-white py-14 lg:py-20"
  aria-labelledby="welcome-heading"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-[2.25rem] border border-brand-mist bg-white shadow-hero"
    >
      <div class="grid lg:grid-cols-[0.95fr_1.05fr]">
        <!-- Columna visual: foto + panel degradado -->
        <div
          class="relative flex flex-col items-center px-6 pb-12 pt-10 sm:px-10 lg:pb-14 lg:pt-12"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-b from-brand-sky via-[#7FB2E5] to-brand-navy lg:rounded-r-[3rem]"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute left-7 top-9 h-16 w-28 lg:left-12"
            style="background-image: radial-gradient(circle, rgba(255,255,255,0.85) 2px, transparent 2px); background-size: 17px 17px;"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute -bottom-12 -left-12 h-56 w-56 rounded-full bg-gradient-to-tr from-brand-green/60 via-brand-green/25 to-transparent blur-2xl"
            aria-hidden="true"
          >
          </div>
          <div
            class="pointer-events-none absolute bottom-9 right-7 select-none font-sans text-lg font-bold leading-4 text-white/40 lg:right-10"
            aria-hidden="true"
          >
            <span class="block">+ + +</span>
            <span class="block">+ + +</span>
            <span class="block">+ + +</span>
          </div>

          <figure class="relative z-10 w-full max-w-[320px] sm:max-w-[350px] lg:max-w-[400px]">
            <div
              class="absolute -left-7 top-10 aspect-square w-full rounded-full border-[3px] border-brand-orange"
              aria-hidden="true"
            >
            </div>
            <img
              src="/images/doctors/olgaBustinza.webp"
              alt="Foto de la M.V.Z. Olga Bustinza, fundadora de Ariel's Clinic"
              width="388"
              height="388"
              loading="lazy"
              class="relative aspect-square w-full rounded-full object-cover object-top shadow-2xl ring-[6px] ring-white/90"
            />
            <PawPrint
              aria-hidden="true"
              class="pointer-events-none absolute left-1 top-1/4 h-20 w-20 text-white/25"
              stroke-width="1.5"
            />
          </figure>

          <div
            class="relative z-10 -mt-16 w-full max-w-[300px] rounded-3xl bg-white px-8 pb-6 pt-8 text-center shadow-card sm:max-w-[340px] sm:px-10"
          >
            <span
              class="absolute -top-7 left-1/2 flex h-14 w-14 -translate-x-1/2 items-center justify-center rounded-full bg-brand-orange text-white shadow-lg ring-4 ring-white"
            >
              <Heart aria-hidden="true" class="h-6 w-6" stroke-width="1.8" />
            </span>
            <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-brand-orange">
              Desde 2003
            </p>
            <p class="mt-2 text-lg font-bold leading-6 text-brand-navy">
              Una vocación que
            </p>
            <p class="font-script text-3xl font-bold leading-8 text-brand-orange">
              continúa
            </p>
            <svg
              viewBox="0 0 80 8"
              class="mx-auto mt-1 h-2 w-20 text-brand-orange"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 5 C 20 1, 55 1, 78 4"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"></path>
            </svg>
          </div>
        </div>

        <!-- Columna de contenido -->
        <article class="relative px-6 pb-10 pt-4 sm:px-10 lg:px-12 lg:py-12 lg:pr-16">
          <header>
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-brand-orange">
              <PawPrint aria-hidden="true" class="h-4 w-4" stroke-width="2" />
              Nuestra forma de cuidar
            </p>
            <h2
              id="welcome-heading"
              class="mt-4 max-w-xl text-3xl font-bold leading-tight tracking-[-0.03em] text-brand-navy sm:text-4xl lg:text-[2.75rem]"
            >
              Profesionalismo y cuidado
              <span class="block text-brand-orange">en cada etapa</span>
            </h2>
            <div class="mt-4 flex items-center gap-1.5" aria-hidden="true">
              <span class="h-1 w-10 rounded-full bg-brand-orange"></span>
              <span class="h-1 w-1.5 rounded-full bg-brand-orange/50"></span>
            </div>
          </header>

          <p class="mt-6 max-w-2xl text-base leading-8 text-brand-ink/75 sm:text-lg">
            Contamos con un equipo altamente calificado y tecnología de vanguardia
            para ofrecer atención integral, desde consultas y cirugías hasta
            cuidados intensivos y servicios de Spa.
          </p>

          <figure
            class="mt-6 flex gap-4 rounded-2xl bg-brand-mist p-5 sm:p-6"
          >
            <Quote
              aria-hidden="true"
              class="h-9 w-9 shrink-0 rotate-180 text-brand-blue"
              stroke-width="1.8"
            />
            <blockquote class="text-sm leading-6 text-brand-ink/80 sm:text-base">
              “Desde que fundé la clínica en 2003, mi sueño ha sido crear un lugar
              donde la excelencia médica y el amor por los animales se unan.”
            </blockquote>
          </figure>

          <figcaption class="mt-4 border-l-[3px] border-brand-orange pl-4">
            <strong class="block text-base font-bold text-brand-navy">
              M.V.Z. Olga Bustinza
            </strong>
            <span class="text-sm text-brand-ink/60">Fundadora</span>
          </figcaption>

          <div class="mt-8 flex flex-wrap items-center gap-2.5" role="list" aria-label="Nuestros valores">
            <span
              class="flex items-center gap-1.5 rounded-full border border-brand-mist bg-white px-3.5 py-1.5 text-xs font-semibold text-brand-navy shadow-card"
              role="listitem"
            >
              <HeartHandshake aria-hidden="true" class="h-4 w-4 text-brand-orange" stroke-width="1.8" />
              Atención personalizada
            </span>
            <span
              class="flex items-center gap-1.5 rounded-full border border-brand-mist bg-white px-3.5 py-1.5 text-xs font-semibold text-brand-navy shadow-card"
              role="listitem"
            >
              <UsersRound aria-hidden="true" class="h-4 w-4 text-brand-blue" stroke-width="1.8" />
              Equipo especializado
            </span>
            <span
              class="flex items-center gap-1.5 rounded-full border border-brand-mist bg-white px-3.5 py-1.5 text-xs font-semibold text-brand-navy shadow-card"
              role="listitem"
            >
              <ShieldCheck aria-hidden="true" class="h-4 w-4 text-brand-green" stroke-width="1.8" />
              Seguridad y confianza
            </span>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
