---
import { Award, Clock3, Heart, MapPin, PawPrint, Star, Tag } from "@lucide/astro";
import SectionDecoration from "@components/ui/SectionDecoration.astro";
import heroSlides from "@data/heroSlides";
---

<section
  id="hero"
  class="relative overflow-hidden bg-brand-surface pb-32 pt-32 sm:pt-36 lg:pb-40 lg:pt-40"
  role="banner"
  aria-labelledby="hero-heading"
>
  <SectionDecoration />
  <div class="relative mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-14">
      <div class="max-w-2xl">
        <div
          data-hero-reveal
          class="mb-5 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-brand-orange"
        >
          <span class="h-2 w-2 rounded-full bg-brand-orange"></span>
          Hospital veterinario en Lima
        </div>

        <h1
          id="hero-heading"
          data-hero-reveal
          class="max-w-2xl text-5xl font-bold leading-[1.08] tracking-[-0.04em] text-brand-navy sm:text-6xl lg:text-[4rem]"
        >
          <span class="block">Medicina veterinaria</span>
          <span class="mt-1 block text-brand-orange">
            con propósito
            <PawPrint
              aria-hidden="true"
              class="ml-1 inline-block h-9 w-9 -translate-y-1 text-brand-navy sm:h-10 sm:w-10"
              stroke-width="2"
            />
          </span>
        </h1>

        <p
          data-hero-reveal
          class="mt-7 max-w-xl text-base leading-8 text-brand-ink/80 sm:text-lg"
        >
          Brindamos atención integral, preventiva y especializada para el
          bienestar y la salud de tu mejor amigo.
        </p>

        <nav
          data-hero-reveal
          class="mt-9 flex flex-col gap-3 sm:flex-row"
          role="navigation"
          aria-label="Acciones principales"
        >
          <a
            href="#promotions"
            class="group inline-flex items-center justify-center gap-3 rounded-xl bg-brand-orange px-6 py-4 text-sm font-semibold text-white shadow-lg shadow-orange-200 transition duration-300 hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-xl focus-visible:outline-brand-orange"
          >
            <Tag
              aria-hidden="true"
              class="h-5 w-5 transition-transform duration-300 group-hover:rotate-[-8deg]"
              stroke-width="1.8"
            />
            Ver promociones
          </a>
          <a
            href="#locations"
            class="inline-flex items-center justify-center gap-3 rounded-xl border border-brand-navy/20 bg-white px-6 py-4 text-sm font-semibold text-brand-navy shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-brand-navy/40 hover:bg-brand-mist hover:shadow-md focus-visible:outline-brand-orange"
          >
            <MapPin aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
            Encontrar ubicación
          </a>
        </nav>

        <div data-hero-reveal class="mt-8 flex items-center gap-3 text-sm text-brand-ink/70">
          <span class="flex -space-x-2" aria-hidden="true">
            <span class="h-7 w-7 rounded-full border-2 border-brand-surface bg-brand-navy"></span>
            <span class="h-7 w-7 rounded-full border-2 border-brand-surface bg-brand-orange"></span>
            <span class="h-7 w-7 rounded-full border-2 border-brand-surface bg-brand-mist"></span>
          </span>
          <span>Atención cercana, profesional y con propósito</span>
        </div>
      </div>

      <div
        data-hero-reveal
        class="hero-visual-shell relative mx-auto w-full max-w-2xl lg:max-w-none"
      >
        <!-- Blob naranja orgánico, asoma abajo-izquierda detrás del marco -->
        <div class="hero-blob hero-blob--orange" aria-hidden="true"></div>
        <!-- Blob gris-azulado, asoma arriba-derecha detrás del chip 24/7 -->
        <div class="hero-blob hero-blob--mist" aria-hidden="true"></div>
        <!-- Rayos decorativos arriba a la derecha -->
        <svg
          class="hero-sparkles"
          viewBox="0 0 40 32"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M20 24V11M14 21L7 14M26 21l7-7"
            stroke="#F5821F"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>

        <div
          class="hero-visual relative aspect-[3/2] shadow-hero"
          data-hero-carousel
          aria-label="Especialidades de Ariel's Clinic en imágenes"
        >
          {
            heroSlides.map((slide, index) => (
              <figure
                class={`hero-slide ${index === 0 ? "is-active" : ""}`}
                data-hero-slide
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width="1600"
                  height="1067"
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : undefined}
                  class="h-full w-full object-cover"
                />
                <figcaption class="hero-slide-label">
                  <span class="hero-slide-label-dot" aria-hidden="true"></span>
                  <span>{slide.label}</span>
                </figcaption>
              </figure>
            ))
          }

          {
            heroSlides.length > 1 && (
              <div
                class="left-1/2 hero-dots"
                role="group"
                aria-label="Seleccionar especialidad"
              >
                {heroSlides.map((slide, index) => (
                  <button
                    type="button"
                    data-hero-dot
                    aria-label={`Ver especialidad ${index + 1}: ${slide.label}`}
                    aria-current={index === 0 ? "true" : "false"}
                    class={`hero-dot ${index === 0 ? "is-active" : ""}`}
                  />
                ))}
              </div>
            )
          }
        </div>

        <!-- Chip 24/7 -->
        <a
          href="#locations"
          class="hero-chip absolute -right-4 top-6 z-20 sm:-right-6 lg:-right-8"
        >
          <span class="hero-chip-icon bg-orange-50 text-brand-orange">
            <Clock3 aria-hidden="true" class="h-5 w-5" stroke-width="2" />
          </span>
          <span>
            <strong class="block text-lg font-bold leading-none text-brand-navy">24/7</strong>
            <span class="mt-1 block text-xs leading-none text-brand-ink/70">Atención de emergencias</span>
          </span>
        </a>

        <!-- Chip de reseñas Google (dato real del listing de Google; actualizar si cambia) -->
        <a
          href="#testimonials"
          class="hero-chip absolute -left-4 bottom-10 z-20 sm:-left-6 lg:-left-8"
        >
          <span class="hidden hero-chip-icon bg-orange-50 text-brand-orange sm:flex">
            <Star aria-hidden="true" class="h-5 w-5" stroke-width="2" />
          </span>
          <span>
            <strong class="flex items-center gap-2 text-lg font-bold leading-none text-brand-navy">
              4.3
              <span class="flex items-center gap-0.5" role="img" aria-label="Calificación: 4.3 de 5 estrellas">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-[#FBBC04]"><path d="M12 2l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6L2.5 9l6.6-.8z"/></svg>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-[#FBBC04]"><path d="M12 2l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6L2.5 9l6.6-.8z"/></svg>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-[#FBBC04]"><path d="M12 2l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6L2.5 9l6.6-.8z"/></svg>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 fill-[#FBBC04]"><path d="M12 2l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6L2.5 9l6.6-.8z"/></svg>
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5">
                  <defs>
                    <linearGradient id="star-partial">
                      <stop offset="30%" stop-color="#FBBC04" />
                      <stop offset="30%" stop-color="#D8E2EF" />
                    </linearGradient>
                  </defs>
                  <path fill="url(#star-partial)" d="M12 2l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6-5.9-3.3-5.9 3.3 1.3-6.6L2.5 9l6.6-.8z"/>
                </svg>
              </span>
            </strong>
            <span class="mt-1 block text-xs leading-none text-brand-ink/70">Reseñas en Google</span>
          </span>
        </a>

        <p data-hero-status class="sr-only" aria-live="polite">
          {heroSlides[0]?.label}
        </p>
      </div>
    </div>

    <div data-hero-reveal class="relative z-20 mx-auto mt-12 -mb-16 max-w-6xl lg:-mt-5">
      <div class="grid overflow-hidden rounded-2xl bg-white shadow-card sm:grid-cols-2 lg:grid-cols-4">
        <div class="flex items-center gap-4 px-5 py-5 sm:px-7 lg:border-r lg:border-slate-100">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-mist text-brand-navy">
            <Award aria-hidden="true" class="h-6 w-6" stroke-width="1.8" />
          </span>
          <span>
            <strong class="block text-xl font-bold leading-none text-brand-navy">20+</strong>
            <span class="mt-1 block text-xs leading-5 text-brand-ink/65">Años de experiencia</span>
          </span>
        </div>

        <div class="flex items-center gap-4 border-t border-slate-100 px-5 py-5 sm:border-t-0 sm:px-7 lg:border-r">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange-50 text-brand-orange">
            <PawPrint aria-hidden="true" class="h-6 w-6" stroke-width="1.8" />
          </span>
          <span>
            <strong class="block text-xl font-bold leading-none text-brand-navy">10Mil+</strong>
            <span class="mt-1 block text-xs leading-5 text-brand-ink/65">Mascotas atendidas</span>
          </span>
        </div>

        <div class="flex items-center gap-4 border-t border-slate-100 px-5 py-5 sm:px-7 lg:border-r lg:border-t-0">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand-mist text-brand-navy">
            <Clock3 aria-hidden="true" class="h-6 w-6" stroke-width="1.8" />
          </span>
          <span>
            <strong class="block text-xl font-bold leading-none text-brand-navy">24/7</strong>
            <span class="mt-1 block text-xs leading-5 text-brand-ink/65">Atención de emergencia</span>
          </span>
        </div>

        <div class="flex items-center gap-4 border-t border-slate-100 px-5 py-5 sm:px-7 lg:border-t-0">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange-50 text-brand-orange">
            <Heart aria-hidden="true" class="h-6 w-6" stroke-width="1.8" />
          </span>
          <span>
            <strong class="block text-base font-bold leading-tight text-brand-navy">Compromiso</strong>
            <span class="mt-1 block text-xs leading-5 text-brand-ink/65">Con el bienestar animal</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-visual {
    position: relative;
    z-index: 10;
    border-radius: 1.75rem;
    overflow: hidden;
  }

  /* Blobs decorativos detrás del marco */
  .hero-blob {
    position: absolute;
    z-index: 0;
  }

  .hero-blob--orange {
    bottom: -8%;
    left: -6%;
    width: 34%;
    height: 42%;
    border-radius: 64% 36% 56% 44% / 48% 58% 42% 52%;
    background: rgb(245 130 31 / 0.18);
    transform: rotate(-8deg);
  }

  .hero-blob--mist {
    top: -10%;
    right: -7%;
    width: 36%;
    height: 46%;
    border-radius: 42% 58% 34% 66% / 56% 40% 60% 44%;
    background: rgb(74 144 217 / 0.12);
    transform: rotate(12deg);
  }

  .hero-sparkles {
    position: absolute;
    top: -2.75rem;
    right: -1rem;
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    opacity: 0.85;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity 700ms ease,
      visibility 700ms ease;
  }

  .hero-slide.is-active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .hero-slide-label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.75);
    backdrop-filter: blur(8px);
    box-shadow: 0 6px 18px -8px rgb(12 44 85 / 0.35);
    color: #1e3a6e;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero-slide-label-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: #f5821f;
  }

  .hero-dots {
    position: absolute;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.7rem;
    border-radius: 9999px;
    background: rgb(30 58 110 / 0.4);
    backdrop-filter: blur(8px);
  }

  .hero-dot {
    display: block;
    height: 0.5rem;
    width: 0.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.5);
    transition: all 300ms ease;
    cursor: pointer;
  }

  .hero-dot:hover {
    background: rgb(255 255 255 / 0.75);
  }

  .hero-dot.is-active {
    width: 1.75rem;
    background: #ffffff;
  }

  .hero-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    border-radius: 1.1rem;
    background: #ffffff;
    box-shadow: 0 16px 38px -18px rgb(12 44 85 / 0.4);
    transition: transform 300ms ease;
  }

  .hero-chip:hover {
    transform: translateY(-2px);
  }

  .hero-chip-icon {
    display: flex;
    height: 2.6rem;
    width: 2.6rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
  }

  [data-hero-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 650ms ease,
      transform 650ms ease;
  }

  [data-hero-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 640px) {
    .hero-blob--mist,
    .hero-sparkles {
      display: none;
    }

    .hero-blob--orange {
      bottom: -5%;
      left: -4%;
      width: 44%;
      height: 32%;
      opacity: 0.7;
    }

    .hero-chip {
      padding: 0.65rem 0.85rem;
      border-radius: 0.9rem;
    }

    .hero-chip strong {
      font-size: 1rem !important;
    }

    .hero-chip-icon {
      height: 2.1rem;
      width: 2.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-dot,
    .hero-chip,
    [data-hero-reveal] {
      transition: none;
    }

    [data-hero-reveal] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script is:inline>
  const heroSection = document.getElementById("hero");

  if (heroSection) {
    const revealElements = heroSection.querySelectorAll("[data-hero-reveal]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    revealElements.forEach((element, index) => {
      window.setTimeout(
        () => element.classList.add("is-visible"),
        reducedMotion ? 0 : 100 + index * 110
      );
    });

    const carousel = heroSection.querySelector("[data-hero-carousel]");
    const slides = Array.from(heroSection.querySelectorAll("[data-hero-slide]"));
    const dots = Array.from(heroSection.querySelectorAll("[data-hero-dot]"));
    const status = heroSection.querySelector("[data-hero-status]");

    if (carousel && slides.length > 1) {
      let activeIndex = 0;
      let timer;

      const updateCarousel = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.classList.toggle("is-active", isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-current", String(isActive));
        });

        const activeLabel = slides[activeIndex].querySelector("figcaption span:last-child");
        if (status && activeLabel) {
          status.textContent = activeLabel.textContent;
        }
      };

      const stopAutoplay = () => {
        if (timer) window.clearInterval(timer);
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (!reducedMotion) {
          timer = window.setInterval(() => updateCarousel(activeIndex + 1), 5000);
        }
      };

      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          updateCarousel(index);
          startAutoplay();
        });
      });

      carousel.addEventListener("mouseenter", stopAutoplay);
      carousel.addEventListener("mouseleave", startAutoplay);
      carousel.addEventListener("focusin", stopAutoplay);
      carousel.addEventListener("focusout", startAutoplay);
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) stopAutoplay();
        else startAutoplay();
      });

      updateCarousel(0);
      startAutoplay();
    }
  }
</script>
