---
import {
  Clock3,
  HeartPulse,
  MapPin,
  Microscope,
  Salad,
  Scissors,
  Stethoscope,
} from "@lucide/astro";

const { name, specialty, imageUrl, location, index = 0 } = Astro.props;

const specialtyIcons = [
  { pattern: /gastro|nutric/i, icon: Salad },
  { pattern: /dermat/i, icon: Microscope },
  { pattern: /cirug/i, icon: Scissors },
  { pattern: /interna|felina/i, icon: HeartPulse },
];

const SpecialtyIcon =
  specialtyIcons.find(({ pattern }) => pattern.test(specialty))?.icon ??
  Stethoscope;

const isAccentOrange = index % 2 === 0;
const anchorId = `doctor-${name.replace(/\s+/g, "-").toLowerCase()}`;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/70 bg-white shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-xl"
  aria-labelledby={anchorId}
>
  <figure class="relative h-60 overflow-hidden sm:h-72">
    <img
      src={imageUrl}
      alt={`Foto profesional del Dr(a). ${name}`}
      class="absolute inset-0 h-full w-full object-cover object-top transition-all duration-500 ease-in-out group-hover:scale-110"
      loading="lazy"
    />

    <span
      class={`absolute left-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-xl shadow-lg ${isAccentOrange ? "bg-brand-orange" : "bg-brand-navy"}`}
    >
      <SpecialtyIcon
        aria-hidden="true"
        class="h-5 w-5 text-white"
        stroke-width={1.8}
      />
    </span>

    <svg
      class="absolute inset-x-0 -bottom-px h-14 w-full"
      viewBox="0 0 400 56"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0 80 L0 24 C120 58 280 -8 400 28 L400 80 Z"
        class={isAccentOrange ? "fill-brand-orange" : "fill-brand-navy"}></path>
      <path
        d="M0 80 L0 31 C120 65 280 -1 400 35 L400 80 Z"
        class="fill-white"></path>
    </svg>
  </figure>

  <section
    class="flex flex-1 flex-col px-5 pb-5 text-center"
    aria-label="Información del médico"
  >
    <h3
      id={anchorId}
      class="text-lg font-bold leading-snug tracking-[-0.02em] text-brand-navy"
    >
      {name}
    </h3>
    <p class="mt-1 text-sm font-medium text-brand-orange">{specialty}</p>

    <div class="mt-auto flex flex-col justify-end">
      <div
        class="space-y-3 border-t border-slate-100 pt-4 text-left text-sm text-brand-ink/80"
      >
        <div class="flex items-center gap-3">
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-mist text-brand-navy"
          >
            <MapPin aria-hidden="true" class="h-4 w-4" stroke-width={1.8} />
          </span>
          <span>Sede - {location}</span>
        </div>
        <div class="flex items-center gap-3">
          <span
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-100 text-brand-orange"
          >
            <Clock3 aria-hidden="true" class="h-4 w-4" stroke-width={1.8} />
          </span>
          <span>Horario a consultar</span>
        </div>
      </div>
    </div>
  </section>
</article>
