---
import { Clock3, MapPin } from "@lucide/astro";

const { name, specialty, imageUrl, location } = Astro.props;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/80 bg-white text-center shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-xl"
  aria-labelledby={`doctor-${name.replace(/\s+/g, "-").toLowerCase()}`}
>
  <div class="h-1 w-full bg-gradient-to-r from-brand-orange to-brand-navy"></div>
  <figure class="flex justify-center px-6 pt-7">
    <img
      src={imageUrl}
      alt={`Foto profesional del Dr(a). ${name}`}
      class="h-32 w-32 rounded-full object-cover object-top ring-4 ring-brand-mist"
      loading="lazy"
    />
    <figcaption class="sr-only">Foto del Dr(a). {name}</figcaption>
  </figure>

  <header class="mt-5 px-6">
    <h3 class="text-lg font-bold leading-tight text-brand-navy">
      {name}
    </h3>
    <p class="mt-1 text-sm font-semibold text-brand-orange">{specialty}</p>
  </header>

  <section
    class="mt-5 space-y-3 border-t border-slate-100 px-6 pt-4 pb-6 text-left text-sm text-brand-ink/80"
    aria-label="Información del médico"
  >
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-mist text-brand-navy">
        <MapPin aria-hidden="true" class="h-4 w-4" stroke-width="1.8" />
      </span>
      <span>Sede - {location}</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-50 text-brand-orange">
        <Clock3 aria-hidden="true" class="h-4 w-4" stroke-width="1.8" />
      </span>
      <span>Horario a consultar</span>
    </div>
  </section>
</article>