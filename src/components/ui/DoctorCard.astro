---
import { Clock3, MapPin } from "@lucide/astro";

const { name, specialty, imageUrl, location } = Astro.props;
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200/70 bg-white shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-xl"
  aria-labelledby={`doctor-${name.replace(/\s+/g, "-").toLowerCase()}`}
>
  <figure class="relative h-64 overflow-hidden sm:h-72">
    <img
      src={imageUrl}
      alt={`Foto profesional del Dr(a). ${name}`}
      class="absolute inset-0 h-full w-full object-cover object-top transition-all duration-500 ease-in-out group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/25 to-transparent transition-all duration-500 group-hover:via-brand-navy/40" />

    <figcaption class="absolute inset-x-0 bottom-0 z-10 p-5 text-white">
      <h3
        id={`doctor-${name.replace(/\s+/g, "-").toLowerCase()}`}
        class="text-lg font-bold leading-snug tracking-[-0.02em]"
      >
        {name}
      </h3>
      <div class="mt-2 flex items-center gap-2">
        <span class="h-0.5 w-5 rounded-full bg-brand-orange" aria-hidden="true" />
        <p class="text-sm text-white/85">{specialty}</p>
      </div>
    </figcaption>
  </figure>

  <section
    class="space-y-3 p-5 text-sm text-brand-ink/80"
    aria-label="Información del médico"
  >
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-mist text-brand-navy">
        <MapPin aria-hidden="true" class="h-4 w-4" stroke-width="1.8" />
      </span>
      <span>Sede - {location}</span>
    </div>
    <div class="flex items-center gap-3">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-orange-50 text-brand-orange">
        <Clock3 aria-hidden="true" class="h-4 w-4" stroke-width="1.8" />
      </span>
      <span>Horario a consultar</span>
    </div>
  </section>
</article>
