---
import { Check } from "@lucide/astro";

const { icon: Icon, title, description, items = [], isFeatured = false, imageUrl, tagline, nota = "", cardIndex = 0 } = Astro.props;

// Acentos de la marca que rotan entre cards estándar: azul → naranja → verde
const accentStyles = [
  { iconBg: "bg-brand-blue/10", iconText: "text-brand-blue-deep", chip: "bg-brand-blue-deep" },
  { iconBg: "bg-brand-orange/10", iconText: "text-brand-orange-vivid", chip: "bg-brand-orange-vivid" },
  { iconBg: "bg-brand-green/10", iconText: "text-brand-green-deep", chip: "bg-brand-green-deep" },
];

// Las cards destacadas (foto) mantienen su estilo; las estándar rotan la paleta
const accent = isFeatured ? accentStyles[0] : accentStyles[((cardIndex >= 3 ? cardIndex - 3 : cardIndex) % 3 + 3) % 3];
---

{
  isFeatured ? (
    <article
      class="group flex h-full w-full flex-col items-center text-center"
      tabindex="0"
      aria-label={`${title}: ${tagline ?? ""}`}
    >
      <!-- Círculo con foto: icono centrado y degradado navy para legibilidad -->
      <div class="relative aspect-square w-full max-w-[260px] shrink-0 overflow-hidden rounded-full shadow-card transition duration-500 group-hover:-translate-y-1 group-hover:shadow-hero sm:max-w-[290px]">
        <img
          src={imageUrl}
          alt={`Imagen de ${title}`}
          class="absolute inset-0 h-full w-full object-cover transition-all duration-500 ease-in-out group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/40 via-35% to-transparent" />
        <div class="absolute left-1/2 top-1/2 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 ring-1 ring-white/30 backdrop-blur-md transition-transform duration-500 ease-out group-hover:scale-110">
          <Icon class="h-7 w-7 text-white" stroke-width={1.8} aria-hidden="true" />
        </div>
        <div class="absolute inset-x-0 bottom-5 px-5">
          <h3 class="text-xl font-bold tracking-[-0.02em] text-white">{title}</h3>
          {tagline && <p class="mt-1 text-sm text-white/85">{tagline}</p>}
        </div>
      </div>

      <!-- Descripción bajo el círculo: completa en móvil; en desktop compacta
           (3 líneas) y se expande suavemente al pasar el mouse o enfocar -->
      <p class="service-desc mt-4 max-w-[290px] text-sm leading-6 text-brand-ink/75">
        {description}
      </p>
    </article>
  ) : (
    <article class="flex h-full flex-col rounded-2xl border border-slate-200/70 bg-white p-6 shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-xl sm:p-7">
      <div class="mb-4 flex items-center gap-4">
        <div
          class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full ${accent.iconBg}`}
        >
          <Icon class={`h-6 w-6 ${accent.iconText}`} stroke-width={1.8} aria-hidden="true" />
        </div>
        <h3 class="text-lg font-bold leading-snug tracking-[-0.02em] text-brand-navy">
          {title}
        </h3>
      </div>

      <span class="mb-4 h-1 w-10 rounded-full bg-brand-orange" aria-hidden="true" />

      <p class="text-sm leading-6 text-brand-ink/70">{description}</p>

      {
        items.length > 0 && (
          <div class="mt-auto rounded-2xl bg-brand-mist px-3 py-4 sm:px-4">
            <p class="text-xs font-bold text-brand-navy">Incluye:</p>
            <ul class="mt-2.5 grid grid-cols-1 gap-x-2 gap-y-2 md:grid-cols-2 md:grid-rows-3 md:content-start">
              {items.map((item) => (
                <li class="flex items-center gap-2 text-xs leading-5 text-brand-ink/80">
                  <span
                    class={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${accent.chip} shadow-sm`}
                    aria-hidden="true"
                  >
                    <Check class="h-3 w-3 text-white" stroke-width={3} />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {nota && (
              <p class="mt-3 min-h-8 border-t border-slate-200/60 pt-2.5 text-[11px] leading-4 text-brand-ink/60">
                {nota}
              </p>
            )}
          </div>
        )
      }
    </article>
  )
}

<style>
  /* Expansión progresiva de la descripción (solo desktop, donde hay hover).
     En móvil se ve completa siempre: nadie pierde información. */
  @media (min-width: 768px) {
    .service-desc {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
      max-height: 4.75rem;
      transition: max-height 450ms ease;
    }
    article:hover .service-desc,
    article:focus .service-desc,
    article:focus-within .service-desc {
      -webkit-line-clamp: 99;
      max-height: 14rem;
    }
  }
</style>
