---
import { Check } from "@lucide/astro";

const { icon: Icon, title, description, items = [], isFeatured = false, imageUrl, tagline, nota = "", cardIndex = 0 } = Astro.props;

// Acentos de la marca que rotan entre cards estándar: azul → naranja → verde
const accentStyles = [
  { iconBg: "bg-brand-blue/10", iconText: "text-brand-blue", chip: "bg-brand-blue" },
  { iconBg: "bg-brand-orange/10", iconText: "text-brand-orange", chip: "bg-brand-orange" },
  { iconBg: "bg-brand-green/10", iconText: "text-brand-green", chip: "bg-brand-green" },
];

// Las cards destacadas (foto) mantienen su estilo; las estándar rotan la paleta
const accent = isFeatured ? accentStyles[0] : accentStyles[((cardIndex >= 3 ? cardIndex - 3 : cardIndex) % 3 + 3) % 3];
---

{
  isFeatured ? (
    <article class="group relative h-80 w-full overflow-hidden rounded-2xl shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-hero">
      <img
        src={imageUrl}
        alt={`Imagen de ${title}`}
        class="absolute inset-0 h-full w-full object-cover transition-all duration-500 ease-in-out group-hover:scale-110"
        loading="lazy"
      />

      <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/40 to-transparent transition-all duration-500 group-hover:via-brand-navy/65 group-hover:to-brand-navy/30" />

      <div class="pointer-events-none absolute inset-x-6 bottom-44 z-10 translate-y-4 opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100">
        <p class="text-xs leading-5 text-white/90 line-clamp-6 [text-shadow:0_1px_2px_rgb(0_0_0/0.35)]">
          {description}
        </p>
      </div>

      <div class="relative z-10 flex h-full flex-col justify-end p-6 text-white">
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-brand-navy ring-4 ring-white/25 transition-transform duration-500 ease-out group-hover:scale-110">
          <Icon class="h-7 w-7 text-white" stroke-width={1.8} aria-hidden="true" />
        </div>
        <h3 class="text-xl font-bold tracking-[-0.02em]">{title}</h3>
        <div class="mt-2 flex items-center gap-2">
          <span class="h-0.5 w-5 rounded-full bg-brand-orange" aria-hidden="true" />
          {tagline && <p class="text-sm text-white/85">{tagline}</p>}
        </div>
      </div>
    </article>
  ) : (
    <article class="flex h-full flex-col rounded-2xl border border-slate-200/70 bg-white p-6 shadow-card transition duration-500 hover:-translate-y-1 hover:shadow-xl sm:p-7">
      <div class="mb-4 flex items-center gap-4">
        <div
          class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full ${accent.iconBg}`}
        >
          <Icon class={`h-6 w-6 ${accent.iconText}`} stroke-width={1.8} aria-hidden="true" />
        </div>
        <h3 class="text-lg font-bold leading-snug tracking-[-0.02em] text-brand-navy">
          {title}
        </h3>
      </div>

      <span class="mb-4 h-1 w-10 rounded-full bg-brand-orange" aria-hidden="true" />

      <p class="text-sm leading-6 text-brand-ink/70">{description}</p>

      {
        items.length > 0 && (
          <div class="mt-auto rounded-2xl bg-brand-mist px-3 py-4 sm:px-4">
            <p class="text-xs font-bold text-brand-navy">Incluye:</p>
            <ul class="mt-2.5 grid grid-cols-1 gap-x-2 gap-y-1.5 md:grid-cols-2 md:grid-rows-3 md:content-start md:gap-y-2">
              {items.map((item) => (
                <li class="flex items-start gap-1.5 text-xs leading-5 text-brand-ink/80">
                  <span
                    class={`mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full ${accent.chip}`}
                    aria-hidden="true"
                  >
                    <Check class="h-2.5 w-2.5 text-white" stroke-width={3.5} />
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            {nota && (
              <p class="mt-3 min-h-8 border-t border-slate-200/60 pt-2.5 text-[11px] leading-4 text-brand-ink/60">
                {nota}
              </p>
            )}
          </div>
        )
      }
    </article>
  )
}
