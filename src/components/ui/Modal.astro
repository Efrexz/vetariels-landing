---
import { X } from "@lucide/astro";
const { modalId } = Astro.props;
---

<dialog
  id={modalId}
  class="p-0 rounded-2xl shadow-2xl backdrop:bg-black/50 w-11/12 max-w-2xl border-gray-200 open:animate-in open:fade-in-0 open:zoom-in-95 duration-300 delay-400"
>
  <div class="relative max-h-[94vh] overflow-y-auto bg-white p-4 sm:p-6">
    <slot />

    <button
      onclick=`document.getElementById('${modalId}').close()`
      class="absolute top-2 right-2 bg-gray-100 rounded-full p-2 text-gray-600 hover:bg-red-100 hover:text-red-600 transition-colors"
      aria-label="Cerrar ventana"
    >
       <X class="h-5 w-5" stroke-width="1.8" />
    </button>
  </div>
</dialog>
