---
import LocationCard from "@components/ui/LocationCard.astro";
import locations from "@data/locations";
import { MapPin } from "@lucide/astro";

const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
---

<section id="locations" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="mx-auto mb-14 max-w-2xl text-center">
      <MapPin
        aria-hidden="true"
        class="mx-auto mb-3 h-9 w-9 text-brand-orange-vivid"
        stroke-width={1.8}
      />
      <h2 class="text-3xl md:text-4xl font-bold tracking-[-0.03em] text-brand-navy">
        Nuestras <span class="text-brand-orange-vivid">Ubicaciones</span>
      </h2>
      <p class="mt-4 text-base leading-7 text-brand-ink/75 sm:text-lg">
        Haz clic en una sede para verla en el mapa. Estamos listos para cuidar
        de tus mascotas.
      </p>
    </header>

    <div
      id="map-container"
      class="rounded-3xl shadow-card border border-slate-100 w-full h-96 md:h-[500px] bg-brand-mist mb-16"
    >
      <!-- Estado alternativo: se muestra si no hay clave de Maps o el script falla -->
      <div
        id="map-fallback"
        class="hidden h-full w-full flex-col items-center justify-center gap-3 px-6 text-center"
      >
        <MapPin
          aria-hidden="true"
          class="h-10 w-10 text-brand-orange-vivid"
          stroke-width={1.8}
        />
        <p class="text-lg font-semibold text-brand-navy">
          No pudimos cargar el mapa en este momento
        </p>
        <p class="max-w-sm text-sm leading-6 text-brand-ink/70">
          Usa los botones <strong>"Cómo llegar"</strong> de cada sede para
          abrir su ubicación directamente en Google Maps.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        locations.map((location) => (
          <div
            data-location-id={location.id}
            data-lat={location.coordinates.lat}
            data-lng={location.coordinates.lng}
            class="location-card-wrapper cursor-pointer"
          >
            <LocationCard
              name={`${location.name}`}
              address={location.address}
              phone={location.phone}
              hours={location.hours}
              whatsapp={location.phone.replace(/\s+/g, "")}
              imageUrl={location.imageUrl}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<!--  ESTILOS PARA LA TARJETA ACTIVA -->
<style>
  .location-card-wrapper {
    transition:
      transform 0.2s ease-out,
      box-shadow 0.2s ease-out;
  }
  .location-card-wrapper.active,
  .location-card-wrapper:hover {
    transform: scale(1.02);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    outline: 2px solid theme("colors.blue.900");
    border-radius: 1rem;
  }
</style>

<script is:inline define:vars={{ apiKey, locations }}>
  const showMapFallback = () => {
    document.getElementById("map-fallback")?.classList.remove("hidden");
    document.getElementById("map-fallback")?.classList.add("flex");
  };

  window.initMap = function () {
    try {
      const mapContainer = document.getElementById("map-container");
      if (!mapContainer) return;

      const map = new google.maps.Map(mapContainer, {
        zoom: 12,
        center: { lat: -12.0464, lng: -77.0428 },
        disableDefaultUI: true,
        zoomControl: true,
      });

      locations.forEach((location) => {
        new google.maps.Marker({
          position: location.coordinates,
          map: map,
          title: `VetAriel - Sede ${location.name}`,
        });
      });

      // El mapa cargó bien: retirar el estado alternativo si estaba visible
      const fallback = document.getElementById("map-fallback");
      if (fallback) {
        fallback.classList.add("hidden");
        fallback.classList.remove("flex");
      }

      const locationCards = document.querySelectorAll(".location-card-wrapper");
      locationCards.forEach((card) => {
        card.addEventListener("click", () => {
          locationCards.forEach((c) => c.classList.remove("active"));
          card.classList.add("active");
          const lat = parseFloat(card.dataset.lat);
          const lng = parseFloat(card.dataset.lng);
          map.panTo({ lat, lng });
          map.setZoom(16);
        });
      });
    } catch (error) {
      console.error("Ocurrió un error al inicializar el mapa:", error);
      showMapFallback();
    }
  };

  if (apiKey) {
    const script = document.createElement("script");
    script.src = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&callback=initMap&v=weekly`;
    script.async = true;
    script.defer = true;
    script.onerror = () => {
      console.error("No se pudo cargar el script de Google Maps.");
      showMapFallback();
    };
    document.body.appendChild(script);
  } else {
    console.error("API Key de Google Maps no encontrada.");
    showMapFallback();
  }
</script>
