---
import DoctorCard from "@components/ui/DoctorCard.astro";
import SectionDecoration from "@components/ui/SectionDecoration.astro";
import { ChevronLeft, ChevronRight, Stethoscope } from "@lucide/astro";
import doctors from "@data/doctors";
---

<section
  id="doctors"
  aria-labelledby="doctors-title"
  class="relative overflow-hidden bg-brand-surface py-20 lg:py-28 opacity-0 translate-y-8 transition-all duration-700 ease-out"
>
  <SectionDecoration />
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mx-auto mb-14 max-w-2xl text-center">
      <Stethoscope
        aria-hidden="true"
        class="mx-auto mb-3 h-9 w-9 text-brand-orange"
        stroke-width={1.8}
      />
      <h2
        id="doctors-title"
        class="text-3xl font-bold tracking-[-0.03em] text-brand-navy sm:text-4xl"
      >
        Conoce a Nuestros <span class="text-brand-orange">Veterinarios</span>
      </h2>
      <p class="mt-4 text-base leading-7 text-brand-ink/75 sm:text-lg">
        Comprometidos con brindar atención experta y cercana a tus mascotas.
      </p>
    </header>

    <div class="embla relative">
      <div class="embla__viewport overflow-hidden">
        <div class="embla__container flex">
          {
            doctors.map((doctor, index) => (
              <div class="embla__slide flex flex-[0_0_90%] pl-3 first:pl-0 sm:flex-[0_0_50%] lg:flex-[0_0_33.333%] lg:pl-5">
                <div class="doctor-slide-content w-full opacity-0 translate-y-4 transition-all duration-500 ease-out">
                  <DoctorCard
                    name={doctor.name}
                    specialty={doctor.specialty}
                    imageUrl={doctor.imageUrl}
                    location={doctor.location}
                    index={index}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <button
        class="embla__prev absolute top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-brand-navy shadow-lg transition hover:bg-brand-orange hover:text-white disabled:cursor-not-allowed disabled:opacity-30 sm:-left-5 sm:flex"
        aria-label="Doctor anterior"
      >
        <ChevronLeft aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
      </button>
      <button
        class="embla__next absolute top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-brand-navy shadow-lg transition hover:bg-brand-orange hover:text-white disabled:cursor-not-allowed disabled:opacity-30 sm:-right-5 sm:flex"
        aria-label="Siguiente doctor"
      >
        <ChevronRight aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
      </button>
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from "embla-carousel";

  document.addEventListener("DOMContentLoaded", () => {
    const doctorsSection = document.getElementById("doctors");
    if (!doctorsSection) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-8");

            const slides = entry.target.querySelectorAll(
                ".doctor-slide-content"
              );
            slides.forEach((slide, index) => {
              window.setTimeout(
                () => slide.classList.remove("opacity-0", "translate-y-4"),
                120 * index
              );
            });

            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    observer.observe(doctorsSection);

    const emblaNode = doctorsSection.querySelector(".embla");
    if (!emblaNode) return;

    const viewportNode = emblaNode.querySelector(
      ".embla__viewport"
    ) as HTMLElement | null;
    const prevBtn = emblaNode.querySelector(
      ".embla__prev"
    ) as HTMLButtonElement | null;
    const nextBtn = emblaNode.querySelector(
      ".embla__next"
    ) as HTMLButtonElement | null;

    if (!viewportNode || !prevBtn || !nextBtn) return;

    const emblaApi = EmblaCarousel(viewportNode, {
      loop: false,
      align: "start",
    });

    const updateButtons = () => {
      prevBtn.disabled = !emblaApi.canScrollPrev();
      nextBtn.disabled = !emblaApi.canScrollNext();
    };

    prevBtn.addEventListener("click", () => emblaApi.scrollPrev(), false);
    nextBtn.addEventListener("click", () => emblaApi.scrollNext(), false);

    emblaApi.on("select", updateButtons);
    emblaApi.on("init", updateButtons);
  });
</script>