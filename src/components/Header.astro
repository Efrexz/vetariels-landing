---
import { CalendarDays, Menu, X } from "@lucide/astro";
import navigationItems from "@data/navegationItems";
import FloatingButton from "@components/ui/FloatingButton.astro";

const desktopNavLinkStyles =
  "group relative rounded-md px-2 py-3 text-sm font-semibold text-brand-navy transition-colors hover:text-brand-orange";
const mobileNavLinkStyles =
  "block rounded-lg px-4 py-3 text-sm font-semibold text-brand-navy transition-colors hover:bg-brand-surface hover:text-brand-orange";
---

<header class="relative z-50">
  <nav
    class="fixed inset-x-0 top-0 border-b border-slate-100/80 bg-white/95 shadow-[0_8px_30px_-24px_rgb(19_55_99_/_0.45)] backdrop-blur-md"
    role="navigation"
    aria-label="Navegación principal"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-20 items-center justify-between lg:h-[84px]">
        <a
          href="#hero"
          class="flex shrink-0 items-center rounded-lg"
          aria-label="Ir al inicio de Ariel's Clinic"
        >
          <img
            src="/logo-png.png"
            alt="Ariel's Clinic Hospital Veterinario"
            width="3820"
            height="2396"
            loading="eager"
            class="h-14 w-auto object-contain sm:h-16"
          />
        </a>

        <div class="hidden lg:block">
          <ul class="flex items-center gap-5" role="menubar">
            {
              navigationItems.map((item) => {
                const isActive = item.href === "#hero";
                return (
                  <li role="none">
                    <a
                      href={item.href}
                      class={`${desktopNavLinkStyles} ${isActive ? "text-brand-orange" : ""}`}
                      aria-label={item.ariaLabel}
                      aria-current={isActive ? "page" : undefined}
                      role="menuitem"
                    >
                      {item.label}
                      <span
                        class={`absolute bottom-1 left-2 right-2 h-0.5 origin-left rounded-full bg-brand-orange transition-transform duration-300 ease-out ${isActive ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
                      ></span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <a
          href="#locations"
          class="hidden items-center gap-2 rounded-xl bg-brand-orange px-5 py-3 text-sm font-semibold text-white shadow-md shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-lg focus-visible:outline-brand-orange lg:flex"
          aria-label="Agendar una cita en una de nuestras sedes"
        >
          <CalendarDays aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
          Agenda tu cita
        </a>

        <button
          id="mobile-menu-button"
          class="rounded-lg p-2 text-brand-navy transition hover:bg-brand-surface hover:text-brand-orange lg:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú principal"
          type="button"
        >
          <Menu id="burger-icon" class="h-6 w-6" stroke-width="2" />
          <X id="close-icon" class="hidden h-7 w-7" stroke-width="2" />
        </button>
      </div>
    </div>

    <div class="hidden border-t border-slate-100 bg-white lg:hidden" id="mobile-menu">
      <div class="mx-auto max-w-7xl px-4 pb-5 pt-3 sm:px-6">
        <ul class="space-y-1" role="menu" aria-label="Menú de navegación móvil">
          {
            navigationItems.map((item) => {
              const IconComponent = item.icon;
              return (
                <li role="none">
                  <a
                    href={item.href}
                    class={mobileNavLinkStyles}
                    aria-label={item.ariaLabel}
                    role="menuitem"
                  >
                    <span class="flex items-center gap-3">
                      <IconComponent class="h-4 w-4 text-brand-orange" aria-hidden="true" />
                      {item.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <a
          href="#locations"
          class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-brand-orange px-5 py-3 text-sm font-semibold text-white shadow-md shadow-orange-200 transition hover:bg-orange-600"
          aria-label="Agendar una cita en una de nuestras sedes"
        >
          <CalendarDays aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
          Agenda tu cita
        </a>
      </div>
    </div>
  </nav>

  <FloatingButton />
</header>

<script is:inline>
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const burgerIcon = document.getElementById("burger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (menuButton && mobileMenu) {
    const setMenuState = (isOpen) => {
      mobileMenu.classList.toggle("hidden", !isOpen);
      burgerIcon?.classList.toggle("hidden", isOpen);
      closeIcon?.classList.toggle("hidden", !isOpen);
      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú principal" : "Abrir menú principal"
      );
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      setMenuState(!isOpen);
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuState(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuState(false);
    });
  }

  const floatingButton = document.getElementById("whatsapp-fab");
  const whatsappOptions = document.getElementById("whatsapp-options");

  if (floatingButton && whatsappOptions) {
    const setWhatsappState = (isOpen) => {
      whatsappOptions.classList.toggle("hidden", !isOpen);
      whatsappOptions.classList.toggle("scale-100", isOpen);
      whatsappOptions.classList.toggle("opacity-100", isOpen);
      whatsappOptions.classList.toggle("scale-95", !isOpen);
      whatsappOptions.classList.toggle("opacity-0", !isOpen);
      floatingButton.setAttribute("aria-expanded", String(isOpen));
    };

    floatingButton.addEventListener("click", (event) => {
      event.stopPropagation();
      const isOpen = floatingButton.getAttribute("aria-expanded") === "true";
      setWhatsappState(!isOpen);
    });

    document.addEventListener("click", (event) => {
      if (
        floatingButton.getAttribute("aria-expanded") === "true" &&
        !whatsappOptions.contains(event.target)
      ) {
        setWhatsappState(false);
      }
    });
  }
</script>
