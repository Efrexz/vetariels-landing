---
import { CalendarDays, Menu, Scissors, X } from "@lucide/astro";
import navigationItems from "@data/navegationItems";

const desktopNavLinkStyles =
  "group relative rounded-md px-2 py-3 text-sm font-semibold text-white/85 transition-colors hover:text-white";
const mobileNavLinkStyles =
  "block rounded-lg px-4 py-3 text-sm font-semibold text-white/85 transition-colors hover:bg-white/10 hover:text-white";
---

<header class="relative z-50">
  <nav
    class="fixed inset-x-0 top-0 bg-gradient-to-r from-[#2B5AA0] via-[#23528E] to-[#1E3A6E] shadow-[0_8px_30px_-18px_rgb(12_44_85/0.7)]"
    role="navigation"
    aria-label="Navegación principal"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex h-20 items-center justify-between lg:h-[84px]">
        <a
          href="#hero"
          class="flex shrink-0 items-center rounded-lg"
          aria-label="Ir al inicio de Ariel's Clinic"
        >
          <img
            src="/logo-white.webp"
            alt="Ariel's Clinic Hospital Veterinario"
            width="1301"
            height="816"
            loading="eager"
            class="h-14 w-auto object-contain sm:h-16"
          />
        </a>

        <div class="hidden lg:block">
          <ul class="flex items-center gap-5">
            {
              navigationItems.map((item) => {
                const isActive = item.href === "#hero";
                return (
                  <li>
                    <a
                      href={item.href}
                      class={`${desktopNavLinkStyles} ${isActive ? "text-brand-orange" : ""}`}
                      aria-label={item.ariaLabel}
                      aria-current={isActive ? "page" : undefined}
                    >
                      {item.label}
                      <span
                        class={`absolute bottom-1 left-2 right-2 h-0.5 origin-left rounded-full bg-brand-orange transition-transform duration-300 ease-out ${isActive ? "scale-x-100" : "scale-x-0 group-hover:scale-x-100"}`}
                      ></span>
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </div>

        <div class="hidden items-center gap-3 lg:flex">
          <a
            href="https://agenda-ariels-nu.vercel.app/?utm_source=vetariel-landing"
            target="_blank"
            rel="noopener noreferrer"
            data-g-event="grooming_link"
            data-g-source="header"
            class="inline-flex items-center gap-2 rounded-xl bg-brand-blue px-4 py-3 text-sm font-semibold text-white shadow-md shadow-sky-950/30 transition hover:-translate-y-0.5 hover:bg-[#5BA1E0] hover:shadow-lg focus-visible:outline-brand-orange"
            aria-label="Agendar un servicio de grooming en la página de agenda de Ariel's Clinic (se abre en una pestaña nueva)"
          >
            <Scissors aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
            Agenda grooming
          </a>
          <a
            href="#locations"
            class="inline-flex items-center gap-2 rounded-xl bg-brand-orange px-5 py-3 text-sm font-semibold text-white shadow-md shadow-orange-200 transition hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-lg focus-visible:outline-brand-orange"
            aria-label="Agendar una cita en una de nuestras sedes"
          >
            <CalendarDays aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
            Agenda tu cita
          </a>
        </div>

        <button
          id="mobile-menu-button"
          class="rounded-lg p-2 text-white transition hover:bg-white/10 hover:text-white lg:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú principal"
          type="button"
        >
          <Menu id="burger-icon" class="h-6 w-6" stroke-width="2" />
          <X id="close-icon" class="hidden h-7 w-7" stroke-width="2" />
        </button>
      </div>
    </div>

    <!-- Franja degradada de marca: borde inferior del navbar -->
    <div
      class="h-1 bg-gradient-to-r from-brand-orange via-[#FFB25E] to-brand-orange sm:h-1.5"
      aria-hidden="true"
    >
    </div>

    <div class="hidden border-t border-white/10 bg-[#1E3A6E] lg:hidden" id="mobile-menu">
      <div class="mx-auto max-w-7xl px-4 pb-5 pt-3 sm:px-6">
        <ul class="space-y-1" aria-label="Menú de navegación móvil">
          {
            navigationItems.map((item) => {
              const IconComponent = item.icon;
              return (
                <li>
                  <a
                    href={item.href}
                    class={mobileNavLinkStyles}
                    aria-label={item.ariaLabel}
                  >
                    <span class="flex items-center gap-3">
                      <IconComponent class="h-4 w-4 text-brand-orange" aria-hidden="true" />
                      {item.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <a
          href="#locations"
          class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-brand-orange px-5 py-3 text-sm font-semibold text-white shadow-md shadow-orange-200 transition hover:bg-orange-600"
          aria-label="Agendar una cita en una de nuestras sedes"
        >
          <CalendarDays aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
          Agenda tu cita
        </a>

        <a
          href="https://agenda-ariels-nu.vercel.app/?utm_source=vetariel-landing"
          target="_blank"
          rel="noopener noreferrer"
          data-g-event="grooming_link"
          data-g-source="menu_movil"
          class="mt-3 hidden items-center justify-center gap-2 rounded-xl bg-brand-blue px-5 py-3 text-sm font-semibold text-white shadow-md shadow-sky-950/30 transition hover:bg-[#5BA1E0] sm:flex lg:hidden"
          aria-label="Agendar un servicio de grooming en la página de agenda de Ariel's Clinic (se abre en una pestaña nueva)"
        >
          <Scissors aria-hidden="true" class="h-5 w-5" stroke-width="1.8" />
          Agenda grooming
        </a>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const burgerIcon = document.getElementById("burger-icon");
  const closeIcon = document.getElementById("close-icon");

  if (menuButton && mobileMenu) {
    const setMenuState = (isOpen) => {
      mobileMenu.classList.toggle("hidden", !isOpen);
      burgerIcon?.classList.toggle("hidden", isOpen);
      closeIcon?.classList.toggle("hidden", !isOpen);
      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.setAttribute(
        "aria-label",
        isOpen ? "Cerrar menú principal" : "Abrir menú principal"
      );
    };

    menuButton.addEventListener("click", () => {
      const isOpen = menuButton.getAttribute("aria-expanded") === "true";
      setMenuState(!isOpen);
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenuState(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setMenuState(false);
    });
  }
</script>
