---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import Welcome from "@components/Welcome.astro";
import Promotions from "@components/Promotions.astro";
import Services from "@components/Services.astro";
import Doctors from "@components/Doctors.astro";
import Locations from "@components/Locations.astro";
import Testimonials from "@components/Testimonials.astro";
import Footer from "@components/Footer.astro";
import FloatingButton from "@components/ui/FloatingButton.astro";
import Chatbot from "@components/Chatbot.astro";
---

<Layout>
  <main>
    <Header />
    <Hero />
    <Welcome />
    <Promotions />
    <Services />
    <Doctors />
    <Locations />
    <Testimonials />
    <Footer />
    <!-- Un solo contenedor para los 2 flotantes: el panel abierto siempre queda encima -->
    <div id="floaters" class="fixed bottom-5 right-5 z-50 flex items-end gap-3">
      <FloatingButton />
      <Chatbot />
    </div>
  </main>
</Layout>
